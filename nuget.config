<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Packages are kept beside the project rather than in the user profile (.nuget is ignored by git). -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
