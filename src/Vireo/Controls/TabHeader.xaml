<UserControl x:Class="Vireo.Controls.TabHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Cursor="Arrow" Focusable="False">
    <Border x:Name="Root" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="10,0,6,0"
            MouseEnter="OnEnter" MouseLeave="OnLeave"
            MouseLeftButtonDown="OnDown" MouseUp="OnUp">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="IconCol" Width="18"/>
                <ColumnDefinition x:Name="TitleCol" Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="CloseCol" Width="22"/>
            </Grid.ColumnDefinitions>

            <!-- Marks the tab being shown when tabs are stacked in a side panel. -->
            <Border x:Name="AccentBar" Grid.ColumnSpan="4" Width="3" Height="16" CornerRadius="1.5" Opacity="0"
                    Background="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Margin="-8,0,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- Page icon, or a spinner while the page loads. -->
            <Grid x:Name="IconHost" Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="FallbackIcon" FontFamily="{StaticResource Icons}" FontSize="12" Text="&#xE774;"
                           Foreground="{StaticResource Text3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="Favicon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Path x:Name="Spinner" Visibility="Collapsed" Stroke="{StaticResource Accent}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 8,2 A 6,6 0 1 1 2,8"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform x:Name="Spin"/></Path.RenderTransform>
                </Path>
            </Grid>

            <TextBlock x:Name="Title" Grid.Column="1" Margin="9,0,4,0" FontSize="12.5" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text2}" Text="New tab"/>

            <!-- Sound playing, or the tab has been put to sleep. -->
            <TextBlock x:Name="Badge" Grid.Column="2" FontFamily="{StaticResource Icons}" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,2,0" Visibility="Collapsed"
                       Foreground="{StaticResource Text3}"/>

            <Button x:Name="Close" Grid.Column="3" Width="20" Height="20" Focusable="False" Cursor="Hand"
                    VerticalAlignment="Center" Opacity="0" Click="OnClose">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent">
                            <TextBlock FontFamily="{StaticResource Icons}" FontSize="8" Text="&#xE8BB;"
                                       Foreground="{StaticResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Surface4}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
