<Window x:Class="Vireo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:Vireo.Controls"
        Title="Vireo" Width="1280" Height="820" MinWidth="560" MinHeight="380"
        Background="{StaticResource FrameBrush}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" Typography.NumeralAlignment="Tabular"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="MenuGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
        <Style x:Key="MenuKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>
        <Style x:Key="MenuRule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Line}"/>
            <Setter Property="Margin" Value="4,5"/>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Frame">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="44"/>      <!-- tabs (or the toolbar when tabs are elsewhere) + window buttons -->
            <RowDefinition x:Name="ToolbarRow" Height="50"/>  <!-- toolbar when tabs are on top -->
            <RowDefinition Height="*"/>                       <!-- pages and side panels -->
            <RowDefinition x:Name="BottomRow" Height="0"/>    <!-- tabs when they are at the bottom -->
        </Grid.RowDefinitions>

        <!-- Row 0 -->
        <Grid x:Name="TitleGrid" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- The mark opens the tab row, the way an app's icon starts its title bar. -->
            <Image x:Name="TabRowMark" Grid.Column="0" Source="{StaticResource AppMark}" Width="24" Height="24" Margin="12,0,8,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Vireo"/>
            <Border x:Name="TopHost" Grid.Column="1"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <!-- Row 1 -->
        <Border x:Name="ToolbarHost" Grid.Row="1"/>

        <!-- Row 2: [left tabs] [pages] [right tabs] [drawer] -->
        <Grid Grid.Row="2" x:Name="Body" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="DrawerCol" Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="LeftHost" Grid.Column="0"/>
            <!-- The page floats as a card in the frame. (Its web view is rounded to match in code: a window cannot be clipped by WPF.) -->
            <Border x:Name="PageCard" Grid.Column="1" CornerRadius="12" Background="{StaticResource Surface1}" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
            <Grid x:Name="Pages" Grid.Column="1" Margin="1"/>
            <Border x:Name="RightHost" Grid.Column="2"/>

            <!-- Drawer: downloads, settings, bookmarks, history. It takes space from the page, so it never hides behind it. -->
            <Border x:Name="Drawer" Grid.Column="3" Width="0" ClipToBounds="True">
                <Border Margin="8,0,0,0" CornerRadius="12" Background="{StaticResource Surface1}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="20,0,10,0">
                        <TextBlock x:Name="DrawerTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" HorizontalAlignment="Right" Click="OnDrawerClose" ToolTip="Close (Esc)"/>
                    </Grid>
                    <ContentPresenter x:Name="DrawerBody" Grid.Row="1" Margin="0,0,0,6"/>
                </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- Row 3 -->
        <Border x:Name="BottomHost" Grid.Row="3"/>

        <!-- Hosts for pieces that move between them. They are not in the layout until placed. -->
        <c:TabStrip x:Name="Tabs" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

        <Border x:Name="Toolbar" Visibility="Collapsed" Background="Transparent">
            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- The mark: only shown when the toolbar shares the title row, where it doubles as a drag handle. -->
                <Border x:Name="Brand" Grid.Column="0" Width="26" Height="26" Margin="6,0,6,0" Visibility="Collapsed" VerticalAlignment="Center" Background="Transparent">
                    <Image Source="{StaticResource AppMark}" Width="24" Height="24"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back (Alt+Left)" Click="OnBack"/>
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward (Alt+Right)" Click="OnForward"/>
                    <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reload (F5)" Click="OnReload"/>
                    <Border x:Name="PrivatePill" Visibility="Collapsed" CornerRadius="5" Padding="8,3" Margin="6,0,2,0" Background="#2E2A3D" BorderBrush="#4D4566" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="Private" FontSize="11.5" FontWeight="SemiBold" Foreground="#C9BEF5"/>
                    </Border>
                </StackPanel>

                <!-- Address bar -->
                <Border x:Name="OmniBox" Grid.Column="2" Height="36" Margin="8,0" CornerRadius="12"
                        Background="{StaticResource Bg}" BorderThickness="1" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border.BorderBrush><SolidColorBrush x:Name="OmniBorder" Color="{StaticResource LineColor}"/></Border.BorderBrush>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OmniIcon" Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13"
                                   Foreground="{StaticResource Text3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="Address" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}"
                                 SelectionBrush="{StaticResource Accent}" SelectionOpacity="0.35" FontFamily="{StaticResource UiFont}" FontSize="13"
                                 VerticalContentAlignment="Center" Padding="0,0,12,0"
                                 GotKeyboardFocus="OnAddressFocus" LostKeyboardFocus="OnAddressBlur" PreviewKeyDown="OnAddressKey"/>
                        <!-- While you are not editing: the site's name stands out, the rest of the address steps back. Clicks go to the box underneath. -->
                        <TextBlock x:Name="AddressView" Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13" Margin="2,0,12,0"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        <TextBlock x:Name="Hint" Grid.Column="1" IsHitTestVisible="False" Text="Search or type an address"
                                   Foreground="{StaticResource Text3}" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Button x:Name="BookmarkButton" Style="{StaticResource IconButton}" Content="&#xE734;" Width="28" Height="26" FontSize="13" ToolTip="Bookmark this page (Ctrl+D)" Click="OnBookmark"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- The buttons of installed extensions -->
                    <StackPanel x:Name="ExtensionStrip" Orientation="Horizontal"/>
                    <!-- Blocked-count shield -->
                    <Button x:Name="MediaButton" Style="{StaticResource IconButton}" ToolTip="Videos and audio on this page" Click="OnMedia" Width="Auto" MinWidth="34">
                        <Border x:Name="MediaPill" CornerRadius="16" Height="32" Padding="9,0" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="20" Height="20">
                            <TextBlock x:Name="MediaIcon" Text="&#xE714;" FontFamily="{StaticResource Icons}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Text2}"/>
                            <Border x:Name="MediaCountHost" Visibility="Collapsed" Background="{StaticResource Accent}" CornerRadius="7" MinWidth="14" Height="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0">
                                <TextBlock x:Name="MediaCount" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentInk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="MediaPillText" FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock.Foreground><SolidColorBrush Color="{StaticResource AccentHoverColor}"/></TextBlock.Foreground>
                        </TextBlock>
                        <!-- The best quality found, as a small label: "4K", "1080p" -->
                        <Border x:Name="MediaQuality" CornerRadius="4" Padding="5,1,5,1" Margin="7,0,1,0" VerticalAlignment="Center" Background="{StaticResource Accent}" Visibility="Collapsed">
                            <TextBlock x:Name="MediaQualityText" FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentInk}"/>
                        </Border>
                        </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="ShieldButton" Style="{StaticResource IconButton}" ToolTip="Blocking" Click="OnShield" Width="Auto" MinWidth="34">
                        <StackPanel Orientation="Horizontal" Margin="9,0">
                            <TextBlock x:Name="ShieldIcon" Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource Text2}"/>
                            <TextBlock x:Name="ShieldCount" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource Text2}"
                                       Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownloadsButton" Style="{StaticResource IconButton}" ToolTip="Downloads (Ctrl+J)" Click="OnDownloads">
                        <Grid Width="28" Height="28">
                            <c:ProgressRing x:Name="DownloadRing" Visibility="Collapsed"/>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="DownloadBadgeHost" Visibility="Collapsed" Background="{StaticResource Accent}" CornerRadius="7" MinWidth="14" Height="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0">
                                <TextBlock x:Name="DownloadBadge" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentInk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0"/>
                            </Border>
                        </Grid>
                    </Button>
                    <!-- Whose browser this is: the profile's first letter in its colour. -->
                    <Button x:Name="ProfileButton" Style="{StaticResource IconButton}" ToolTip="Profiles" Click="OnProfiles">
                        <Border x:Name="ProfileBadge" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}">
                            <TextBlock x:Name="ProfileInitial" Text="P" FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Grid>
                        <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Menu" Click="OnMenu"/>
                        <!-- An update is downloaded and waiting: a small dot, the way other browsers say so. -->
                        <Ellipse x:Name="UpdateDot" Width="8" Height="8" Fill="{StaticResource Accent}" Stroke="{StaticResource Surface1}" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>

                <!-- Loading bar: a short bar of light that runs along the bottom edge while a page loads. -->
                <Border x:Name="LoadTrack" VerticalAlignment="Bottom" Height="2" Margin="-8,0,-8,-1" ClipToBounds="True"
                        IsHitTestVisible="False" Opacity="0" Grid.ColumnSpan="4">
                    <Border x:Name="LoadBar" Width="180" HorizontalAlignment="Left" CornerRadius="1" RenderTransformOrigin="0,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#003DDBB9" Offset="0"/>
                                <GradientStop Color="#3DDBB9" Offset="0.7"/>
                                <GradientStop Color="#C4F7EA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform><TranslateTransform x:Name="LoadSlide" X="-180"/></Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- The side panel that holds the tab list when tabs are on the left or right. -->
        <Border x:Name="SideTabs" Visibility="Collapsed" Background="Transparent" Width="248" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="8,6,8,0">
                    <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE700;" HorizontalAlignment="Left" ToolTip="Collapse the tab panel" Click="OnCollapseTabs"/>
                    <TextBlock x:Name="SideTitle" Text="Tabs" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="44,0,0,0"/>
                </Grid>
                <ScrollViewer x:Name="SideScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"/>
            </Grid>
        </Border>

        <!-- Menu: a separate popup window, so it can sit on top of the page (web content is its own window). -->
        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom"
               HorizontalOffset="-262" VerticalOffset="2" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="None" Grid.Row="1">
            <Border x:Name="MenuCard" TextElement.Foreground="{StaticResource Text}" TextElement.FontFamily="{StaticResource UiFont}"
                    Width="292" Margin="14" CornerRadius="14" Background="{StaticResource Surface2}" Typography.NumeralAlignment="Tabular"
                    BorderBrush="{StaticResource Line2}" BorderThickness="1" RenderTransformOrigin="1,0" Opacity="0">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.5" Color="Black"/></Border.Effect>
                <Border.RenderTransform><ScaleTransform x:Name="MenuScale" ScaleX="0.97" ScaleY="0.97"/></Border.RenderTransform>
                <!-- On a short screen the menu scrolls instead of running off the bottom. -->
                <ScrollViewer x:Name="MenuScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="5">
                    <Button x:Name="UpdateMenuItem" Style="{StaticResource MenuItem}" Click="OnMenuUpdate" Visibility="Collapsed" Margin="0,0,0,4">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE777;" Foreground="{StaticResource Accent}"/><TextBlock x:Name="UpdateMenuText" Text="Restart to update" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuNewTab">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE710;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+T"/><TextBlock Text="New tab"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuNewWindow">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE737;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+N"/><TextBlock Text="New window"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuPrivate">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8A7;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+Shift+N"/><TextBlock Text="New private window"/></DockPanel>
                    </Button>
                    <Border Style="{StaticResource MenuRule}"/>

                    <Button Style="{StaticResource MenuItem}" Click="OnMenuDownloads">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE896;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+J"/><TextBlock Text="Downloads"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuGrabber">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8B3;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+Shift+G"/><TextBlock Text="Save all from this page…" TextTrimming="CharacterEllipsis"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuBookmarks">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE728;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+Shift+O"/><TextBlock Text="Bookmarks"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuHistory">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE81C;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+H"/><TextBlock Text="History"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuExtensions">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEA86;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+Shift+E"/><TextBlock Text="Extensions"/></DockPanel>
                    </Button>
                    <Border Style="{StaticResource MenuRule}"/>

                    <Grid Margin="10,1,4,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE71E;"/>
                        <TextBlock Grid.Column="1" Text="Zoom" VerticalAlignment="Center" FontSize="13"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE738;" Width="28" Height="28" FontSize="11" ToolTip="Zoom out (Ctrl+-)" Click="OnMenuZoomOut"/>
                        <TextBlock x:Name="MenuZoomText" Grid.Column="3" Text="100%" Width="46" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Text2}" Cursor="Hand" ToolTip="Reset zoom (Ctrl+0)" MouseLeftButtonUp="OnMenuZoomReset"/>
                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE710;" Width="28" Height="28" FontSize="11" ToolTip="Zoom in (Ctrl++)" Click="OnMenuZoomIn"/>
                        <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE740;" Width="28" Height="28" FontSize="11" Margin="4,0,0,0" ToolTip="Full screen (F11)" Click="OnMenuFullscreen"/>
                    </Grid>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuFind">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE721;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+F"/><TextBlock Text="Find on page…"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuPrint">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE749;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+P"/><TextBlock Text="Print…"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuDevTools">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE943;"/><TextBlock Style="{StaticResource MenuKey}" Text="F12"/><TextBlock Text="Developer tools"/></DockPanel>
                    </Button>
                    <Border Style="{StaticResource MenuRule}"/>

                    <DockPanel Margin="10,5,6,5">
                        <TextBlock Text="Tabs" VerticalAlignment="Center" FontSize="13" Width="40"/>
                        <Border Background="{StaticResource Bg}" CornerRadius="7" Padding="2">
                            <UniformGrid x:Name="SideChooser" Rows="1"/>
                        </Border>
                    </DockPanel>
                    <Button Style="{StaticResource MenuItem}" Click="OnProfiles">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE77B;"/><TextBlock Text="Profiles"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuSync">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE895;"/><TextBlock Text="Sync"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuImport">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8B5;"/><TextBlock Text="Import from another browser…"/></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuSettings">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE713;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+,"/><TextBlock Text="Settings"/></DockPanel>
                    </Button>
                    <Border Style="{StaticResource MenuRule}"/>

                    <!-- Memory: what the tabs use right now, and a button to free it. -->
                    <Grid Margin="10,6,6,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Memory" FontSize="13"/>
                                <TextBlock x:Name="MemoryTotal" Text="" FontSize="12.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Text2}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MemorySummary" Text="" FontSize="11.5" Foreground="{StaticResource Text3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Free now" FontSize="11.5" Padding="10,4" VerticalAlignment="Center" ToolTip="Puts hidden tabs to sleep" Click="OnMenuFreeNow"/>
                    </Grid>
                    <!-- The full list of tabs lives in its own panel, so the menu stays short however many tabs are open. -->
                    <Button Style="{StaticResource MenuItem}" Click="OnMenuAllTabs" Margin="0,2,0,0">
                        <DockPanel><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8A9;"/><TextBlock Style="{StaticResource MenuKey}" Text="Ctrl+Shift+A"/><TextBlock x:Name="AllTabsText" Text="See all tabs"/></DockPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Window>
