<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Vireo</AssemblyName>
    <RootNamespace>Vireo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\vireo.ico</ApplicationIcon>
    <!-- The one version number: the About page, the installer (setup.iss) and the release tag (vX.Y.Z) must agree with it. -->
    <Version>1.1.0</Version>
    <Product>Vireo</Product>
    <Company>Refora Technologies</Company>
    <Copyright>Copyright (C) 2026 Refora Technologies</Copyright>
    <Description>Vireo browser</Description>
    <!-- Small and quick to start. -->
    <TieredPGO>false</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <!-- Reads other browsers' bookmark and history files. winsqlite3 is the SQLite that comes with Windows, so nothing extra is shipped. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.*" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.*" />
    <!-- Checks the signature on Vireo's rules files (Ed25519, BLAKE2b). Managed code only, MIT licence. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Plus Jakarta Sans (SIL Open Font License, Fonts\OFL.txt), built into the program. -->
    <Resource Include="Fonts\*.ttf" />
    <!-- Refora's rules key (the public half), made with tools/vireo-sign. Until it exists, Vireo uses its built-in rules only. -->
    <EmbeddedResource Include="rules-key.pub" LogicalName="rules-key.pub" Condition="Exists('rules-key.pub')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vireo.Tests" />
  </ItemGroup>

</Project>
